# DECISION: Ignore build output, IDE caches, secrets, and OS junk to prevent repo bloat and credential leaks.
# ALTERNATIVES: Checking in wrappers only, ignoring everything else.
# INVARIANT: Never commit credentials, local env files, or build artifacts.
# SEE: ADR-002

# Gradle
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar

# Java / JVM
*.class
*.log
*.ctxt
.mtj.tmp/
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar
hs_err_pid*
replay_pid*

# IntelliJ IDEA
.idea/
*.iws
*.iml
*.ipr
out/

# VS Code
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Environment and Secrets
# INVARIANT: Secrets must never enter git history.
*.env
*.env.local
*.pem
*.key
credentials.json

# Testcontainers / Docker local volumes
.testcontainers.properties
